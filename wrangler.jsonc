{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slogan",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // 静态资源（前台 / 后台页面）
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // 所有请求先进 Worker：保证自定义 ADMIN_PATH 生效，静态资源统一经 ASSETS 绑定输出
    "run_worker_first": true
  },

  // D1 数据库：只声明 binding，首次 deploy 时由 Cloudflare 自动创建并绑定（Wrangler 4.45+）
  // 已有真实 D1 时可手动补回 database_name / database_id，沿用旧数据
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],

  // 媒体库：只声明 binding，Wrangler 4.45+ 首次 deploy 时自动创建 R2 桶并绑定
  "r2_buckets": [
    {
      "binding": "BUCKET"
    }
  ],

  "vars": {
    "ADMIN_PATH": "admin"
  },

  // 每 5 分钟关闭一次超时未支付订单
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
